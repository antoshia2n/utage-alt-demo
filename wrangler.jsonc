{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utage-alt-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  // 設定の値 4 つ（SUPABASE_URL・SUPABASE_PUBLISHABLE_KEY・SUPABASE_SECRET_KEY・MCP_SECRET）は
  // すべて Cloudflare の画面に Secret として置く。ここに書かないので、上げ直しても消えない。
  "keep_vars": true,
  "observability": { "enabled": true }
}
